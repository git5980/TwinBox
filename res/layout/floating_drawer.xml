<?xml version="1.0" encoding="utf-8"?>
<!--
  TwinBox 2.1.63：VMOS 式抽屉容器（把手 + 侧面板一体化）。
  布局：[把手竖条][面板]。贴边态容器整体停在屏外，只露把手；
  拖把手把面板从右缘拉出来，反向推回去（FloatingService 手势驱动）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!-- 把手：竖条 + 箭头（‹ 贴边待拉出 / › 展开待推回，代码按态切换） -->
    <TextView
        android:id="@+id/drawer_handle"
        android:layout_width="34dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_handle"
        android:gravity="center"
        android:text="‹"
        android:textColor="@color/md_primary"
        android:textSize="22sp"
        android:contentDescription="@string/drawer_handle_desc" />

    <!-- 侧面板：沿用 floating_panel 的结构与 ID（panel_items） -->
    <LinearLayout
        android:id="@+id/drawer_panel"
        android:layout_width="@dimen/panel_width"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:padding="@dimen/md_space_sm">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/md_space_sm"
            android:paddingEnd="@dimen/md_space_sm"
            android:paddingTop="@dimen/md_space_sm"
            android:paddingBottom="@dimen/md_space_sm"
            android:textSize="@dimen/md_type_label"
            android:textColor="@color/md_on_surface_variant"
            android:text="@string/panel_title" />

        <LinearLayout
            android:id="@+id/panel_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
