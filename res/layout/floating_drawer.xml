<?xml version="1.0" encoding="utf-8"?>
<!--
  TwinBox 2.2.1：VMOS 式悬浮球（圆球 + 侧面板）。
  布局：[圆球][面板]。球可自由拖动（贴边吸附），点击=菜单；
  贴右缘时向左拖=拉出窗户（虚拟屏浮窗/窗帘），VMOS 同款交互。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!-- TwinBox 2.2.1：VMOS 式悬浮球（圆形，自由拖动+贴边吸附，点击=菜单） -->
    <FrameLayout
        android:id="@+id/drawer_handle"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:contentDescription="@string/drawer_handle_desc">

        <TextView
            android:id="@+id/ball_face"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ball"
            android:gravity="center"
            android:text="◫"
            android:textColor="#FF8FA8E8"
            android:textSize="24sp" />
    </FrameLayout>

    <!-- 侧面板：沿用 floating_panel 的结构与 ID（panel_items） -->
    <LinearLayout
        android:id="@+id/drawer_panel"
        android:layout_width="@dimen/panel_width"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:padding="@dimen/md_space_sm">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/md_space_sm"
            android:paddingEnd="@dimen/md_space_sm"
            android:paddingTop="@dimen/md_space_sm"
            android:paddingBottom="@dimen/md_space_sm"
            android:textSize="@dimen/md_type_label"
            android:textColor="@color/md_on_surface_variant"
            android:text="@string/panel_title" />

        <LinearLayout
            android:id="@+id/panel_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
