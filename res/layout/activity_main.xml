<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!--
      TwinBox 2.0.8：主题从 Theme.Material.NoActionBar 换成 Theme.Material，
      由框架 ActionBar 提供标题栏与溢出菜单（res/menu/menu_main.xml），
      布局里不再自摆 Toolbar，避免出现双标题栏。
    -->

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:text="@string/status_ready" />

    <GridView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="4"
        android:padding="12dp"
        android:horizontalSpacing="10dp"
        android:verticalSpacing="14dp" />

    <LinearLayout
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:text="@string/empty_title" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:text="@string/empty_hint" />
        <Button
            android:id="@+id/btn_install_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/btn_install"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/accent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical">
        <Button
            android:id="@+id/btn_add_apk"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/btn_add_apk"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/accent" />
        <Button
            android:id="@+id/btn_clone"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/btn_clone"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/accent2" />
        <ImageButton
            android:id="@+id/btn_float"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:src="@android:drawable/ic_menu_more"
            android:background="@drawable/btn_float_bg"
            android:contentDescription="@string/btn_float"
            android:scaleType="center" />
    </LinearLayout>
</LinearLayout>
