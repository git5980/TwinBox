<?xml version="1.0" encoding="utf-8"?>
<!--
  TwinBox Design 2.1.48：容器桌面（主界面）。
  结构：状态条 → 九宫格 → 空态 → 底部操作栏（双胶囊 + 悬浮球圆形图标按钮）。
  ID 全部沿用旧版（MainActivity 零改动）：status / grid / empty /
  btn_install_empty / btn_add_apk / btn_clone / btn_float。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_surface">

    <!--
      TwinBox 2.0.8：主题从 Theme.Material.NoActionBar 换成 Theme.Material，
      由框架 ActionBar 提供标题栏与溢出菜单（res/menu/menu_main.xml），
      布局里不再自摆 Toolbar，避免出现双标题栏。
    -->

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/md_space_lg"
        android:paddingEnd="@dimen/md_space_lg"
        android:paddingTop="@dimen/md_space_sm"
        android:paddingBottom="@dimen/md_space_sm"
        android:textSize="@dimen/md_type_label"
        android:textColor="@color/md_on_surface_variant"
        android:text="@string/status_ready" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="4"
            android:paddingStart="@dimen/md_space_md"
            android:paddingEnd="@dimen/md_space_md"
            android:paddingTop="@dimen/md_space_sm"
            android:paddingBottom="@dimen/md_space_md"
            android:horizontalSpacing="@dimen/md_space_sm"
            android:verticalSpacing="@dimen/md_space_md"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:listSelector="@drawable/ripple_tile"
            android:clipToPadding="false" />

        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/md_space_xxl">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_grid_apps"
                android:alpha="0.35" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/md_space_lg"
                android:textSize="@dimen/md_type_headline"
                android:textColor="@color/md_on_surface"
                android:text="@string/empty_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/md_space_xs"
                android:textSize="@dimen/md_type_body"
                android:textColor="@color/md_on_surface_variant"
                android:text="@string/empty_hint" />

            <Button
                android:id="@+id/btn_install_empty"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/md_btn_height"
                android:layout_marginTop="@dimen/md_space_xl"
                android:paddingStart="@dimen/md_space_xxl"
                android:paddingEnd="@dimen/md_space_xxl"
                android:background="@drawable/btn_pill_primary"
                android:stateListAnimator="@null"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:textAllCaps="false"
                android:textSize="@dimen/md_type_body"
                android:textColor="@color/md_on_primary"
                android:text="@string/btn_install" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:layout_marginStart="@dimen/md_space_md"
        android:layout_marginEnd="@dimen/md_space_md"
        android:layout_marginBottom="@dimen/md_space_md"
        android:padding="@dimen/md_space_sm">

        <Button
            android:id="@+id/btn_add_apk"
            android:layout_width="0dp"
            android:layout_height="@dimen/md_btn_height"
            android:layout_weight="1"
            android:background="@drawable/btn_pill_primary"
            android:stateListAnimator="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:textAllCaps="false"
            android:textSize="@dimen/md_type_body"
            android:textColor="@color/md_on_primary"
            android:text="@string/btn_add_apk" />

        <Button
            android:id="@+id/btn_clone"
            android:layout_width="0dp"
            android:layout_height="@dimen/md_btn_height"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/md_space_sm"
            android:background="@drawable/btn_pill_purple"
            android:stateListAnimator="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:textAllCaps="false"
            android:textSize="@dimen/md_type_body"
            android:textColor="@color/md_on_secondary"
            android:text="@string/btn_clone" />

        <ImageButton
            android:id="@+id/btn_float"
            android:layout_width="@dimen/md_icon_btn_size"
            android:layout_height="@dimen/md_icon_btn_size"
            android:layout_marginStart="@dimen/md_space_sm"
            android:background="@drawable/btn_float_bg"
            android:src="@drawable/ic_grid_apps"
            android:scaleType="centerInside"
            android:contentDescription="@string/btn_float" />
    </LinearLayout>
</LinearLayout>
