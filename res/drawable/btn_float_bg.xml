<?xml version="1.0" encoding="utf-8"?>
<!--
  TwinBox Design 2.1.48：悬浮球开关按钮（MD3 图标按钮）。
  文件名保留 btn_float_bg（历史引用兼容）。
  状态语义不变：selected=悬浮球运行中（主色实底），否则表面色容器底；
  外圈涟漪反馈，图形用 ic_grid_apps 矢量（容器桌面）。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <ripple android:color="#33FFFFFF">
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/md_primary" />
                </shape>
            </item>
        </ripple>
    </item>
    <item>
        <ripple android:color="@color/md_ripple">
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/md_surface_container" />
                    <stroke android:width="1dp" android:color="@color/md_outline" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
