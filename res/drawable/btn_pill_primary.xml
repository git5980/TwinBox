<?xml version="1.0" encoding="utf-8"?>
<!-- TwinBox Design：主操作胶囊按钮（星云蓝） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_primary_dim" />
            <corners android:radius="@dimen/md_radius_full" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_primary" />
            <stroke android:width="2dp" android:color="@color/md_on_surface" />
            <corners android:radius="@dimen/md_radius_full" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/md_primary" />
            <corners android:radius="@dimen/md_radius_full" />
        </shape>
    </item>
</selector>
