<?xml version="1.0" encoding="utf-8"?>
<!-- TwinBox Design：弱操作胶囊（表面色容器底） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_surface_variant" />
            <corners android:radius="@dimen/md_radius_full" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/md_surface_container" />
            <corners android:radius="@dimen/md_radius_full" />
        </shape>
    </item>
</selector>
